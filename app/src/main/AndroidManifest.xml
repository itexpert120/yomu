<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Word lookups, explicit web searches, user-initiated Google Fonts downloads, and sync. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sync reconnects when the network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for scanning a sync QR code; asked for when the scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Read aloud keeps speaking outside the app as a media-playback foreground service. Its
         media-session notification is exempt from POST_NOTIFICATIONS, so that isn't asked for. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Lets TextToSpeech find and bind the installed speech engines (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Apps that take selected text (Translate, dictionaries): listed after the reader's own
         selection actions, and the look-up sheet's Translate. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TRANSLATE" />
        </intent>
    </queries>

    <application
        android:name=".YomuApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yomu">
        <activity
            android:name=".app.devgallery.DevGalleryActivity"
            android:exported="false"
            android:theme="@style/Theme.Yomu" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Yomu.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launcher quick actions: Search library, Import books, Statistics (+ a dynamic
                 "Continue <book>"). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Open an EPUB declared with the correct mime type (file managers, document apps). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>

            <!-- Real-world fallback: many senders use a generic/octet-stream mime, so match on the
                 .epub path. pathPattern needs scheme+host, so we enumerate the common schemes/hosts
                 and the leading-".*" workaround for paths with arbitrary prefixes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\..*\\.epub" />
                <data android:pathPattern=".*\\..*\\..*\\.epub" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.epub" />
            </intent-filter>

            <!-- Share a single EPUB into Yomu (WhatsApp/Gmail/etc.). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>

        <!-- Read aloud's media session: notification, lock-screen and headset controls. Exported
             so system UI, Bluetooth and car controllers can connect, as media3 requires. -->
        <service
            android:name=".data.readaloud.ReadAloudService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Shares the local diagnostics log (Settings → About → Diagnostics). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>
    </application>

</manifest>
