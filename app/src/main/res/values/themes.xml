<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Yomu" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="yomuSplashMarkColor">@color/yomu_splash_mark</item>
    </style>

    <style name="Theme.Yomu.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yomu_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_yomu_mark</item>
        <item name="yomuSplashMarkColor">@color/yomu_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Yomu</item>
        <item name="android:windowLightStatusBar">@bool/yomu_splash_light_system_bars</item>
        <item name="android:statusBarColor">@color/yomu_splash_background</item>
        <item name="android:navigationBarColor">@color/yomu_splash_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Yomu.Starting.Light" parent="Theme.Yomu.Starting">
        <item name="windowSplashScreenBackground">@color/yomu_splash_background_light</item>
        <item name="yomuSplashMarkColor">@color/yomu_splash_mark_light</item>
        <item name="android:windowLightStatusBar">@bool/yomu_splash_force_light_system_bars</item>
        <item name="android:statusBarColor">@color/yomu_splash_background_light</item>
        <item name="android:navigationBarColor">@color/yomu_splash_background_light</item>
    </style>

    <style name="Theme.Yomu.Starting.Dark" parent="Theme.Yomu.Starting">
        <item name="windowSplashScreenBackground">@color/yomu_splash_background_dark</item>
        <item name="yomuSplashMarkColor">@color/yomu_splash_mark_dark</item>
        <item name="android:windowLightStatusBar">@bool/yomu_splash_force_dark_system_bars</item>
        <item name="android:statusBarColor">@color/yomu_splash_background_dark</item>
        <item name="android:navigationBarColor">@color/yomu_splash_background_dark</item>
    </style>

    <style name="Theme.Yomu.Starting.Oled" parent="Theme.Yomu.Starting">
        <item name="windowSplashScreenBackground">@color/yomu_splash_background_oled</item>
        <item name="yomuSplashMarkColor">@color/yomu_splash_mark_oled</item>
        <item name="android:windowLightStatusBar">@bool/yomu_splash_force_dark_system_bars</item>
        <item name="android:statusBarColor">@color/yomu_splash_background_oled</item>
        <item name="android:navigationBarColor">@color/yomu_splash_background_oled</item>
    </style>

    <style name="Theme.Yomu.Starting.SystemOled" parent="Theme.Yomu.Starting">
        <item name="windowSplashScreenBackground">@color/yomu_splash_background_system_oled</item>
        <item name="yomuSplashMarkColor">@color/yomu_splash_mark_system_oled</item>
        <item name="android:statusBarColor">@color/yomu_splash_background_system_oled</item>
        <item name="android:navigationBarColor">@color/yomu_splash_background_system_oled</item>
    </style>
</resources>
